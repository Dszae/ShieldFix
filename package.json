{
  "name": "shieldfix",
  "version": "1.0.0",
  "private": true,
  "description": "Privacy-first browser extension for Brave and Chrome that detects 'Ad blocker detected' walls and fixes them with one reversible click, without turning off Brave Shields.",
  "keywords": [
    "browser-extension",
    "chrome-extension",
    "brave",
    "brave-shields",
    "adblock",
    "anti-adblock",
    "adblock-detection",
    "ad-blocker",
    "privacy",
    "manifest-v3"
  ],
  "homepage": "https://github.com/Dszae/ShieldFix#readme",
  "bugs": {
    "url": "https://github.com/Dszae/ShieldFix/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Dszae/ShieldFix.git"
  },
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "node scripts/build.mjs --watch",
    "build": "node scripts/build.mjs",
    "build:e2e": "node scripts/build.mjs --e2e",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "npm run build && npm run build:e2e && playwright test",
    "icons": "node scripts/generate-icons.mjs",
    "assets": "npm run build:e2e && node scripts/store-assets.mjs",
    "package": "npm run build && node scripts/package.mjs",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run test && npm run build",
    "media": "npm run build:e2e && node scripts/readme-media.mjs"
  },
  "dependencies": {
    "lucide-react": "1.74.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.1",
    "@tailwindcss/vite": "4.3.5",
    "@types/chrome": "0.3.7",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "eslint": "10.15.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.8",
    "globals": "17.14.0",
    "happy-dom": "21.0.4",
    "prettier": "3.10.1",
    "tailwindcss": "4.3.5",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  }
}
